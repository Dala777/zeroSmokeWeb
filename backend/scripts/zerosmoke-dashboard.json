    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.0" },
    { "type": "datasource", "id": "yesoreyeram-infinity-datasource", "name": "Infinity", "version": "2.5.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "ZeroSmoke — Clinical Research Dashboard",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Usuarios Registrados",
      "description": "Total acumulado de usuarios en la plataforma",
      "type": "stat",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "ZS_API" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "sparkline": { "show": true, "yMin": null, "yMax": null, "lineWidth": 2, "fillOpacity": 25, "lineColor": "#1A6B5A" } },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#1A6B5A" }] },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "query": "/summary?format=grafana",
          "type": "json",
          "parser": "json",
          "root_selector": "totalUsers",
          "url": "",
          "method": "GET",
          "headers": [],
          "data": ""
        },
        {
          "query": "/users?from=${__from:date:YYYY-MM-DD}&to=${__to:date:YYYY-MM-DD}&granularity=day&format=grafana",
          "type": "json",
          "parser": "json",
          "root_selector": "",
          "url": "",
          "method": "GET",
          "headers": [],
          "data": "",
          "timeField": "time",
          "valueField": "value",
          "alias": "sparkline"
        }
      ],
      "transformations": []
    },
    {
      "id": 3,
      "title": "Usuarios Activos (Hoy)",
      "description": "Usuarios con estado activo en las últimas 24h",
      "type": "stat",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "ZS_API" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "sparkline": { "show": true, "lineWidth": 2, "fillOpacity": 25, "lineColor": "#3B82F6" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#6B7280" }, { "value": 1, "color": "#3B82F6" }] },
          "unit": "none",
          "decimals": 0
        }
      },
      "options": { "graphMode": "area", "justifyMode": "center", "textMode": "value_and_name", "colorMode": "value" },
      "targets": [{ "query": "/summary?format=grafana", "type": "json", "parser": "json", "root_selector": "activeUsers" }]
    },
    {
      "id": 4,
      "title": "Craving Promedio (Hoy)",
      "description": "Nivel de ansiedad promedio en escala 0\u201310",
      "type": "stat",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "ZS_API" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "sparkline": { "show": true, "lineWidth": 2, "fillOpacity": 25, "lineColor": "#EAB308" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#22C55E" }, { "value": 4, "color": "#EAB308" }, { "value": 7, "color": "#DC2626" }] },
          "unit": "none",
          "decimals": 1,
          "max": 10
        }
      },
      "options": {
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "colorMode": "thresholds",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
